{
  "name": "jarvisvx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first voice and terminal AI assistant.",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "jarvis": "./bin/jarvis.mjs"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node daemon.mjs",
    "daemon": "node daemon.mjs",
    "desktop": "electron .",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3210 && electron .\"",
    "package:desktop": "npm run build && electron-builder",
    "test": "node --test --test-concurrency=1",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dotenv": "^17.2.3",
    "electron": "^39.2.1",
    "express": "^5.1.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "local.jarvisvx.desktop",
    "productName": "JARVISvX",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "lib/**/*",
      "bin/**/*",
      "daemon.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-web/**/*"
    ]
  },
  "extraResources": [
    {
      "from": "src/icon/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "src/icon/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "icon": "src/icon/icon.ico"
  },
  "linux": {
    "icon": "src/icon/icon.png"
  }
}
