{
  "name": "jarvisvx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first voice and terminal AI assistant.",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "jarvis": "./bin/jarvis.mjs"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node daemon.mjs",
    "daemon": "node daemon.mjs",
    "desktop": "electron .",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3210 && electron .\"",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test": "node --test --test-concurrency=1 test/application.test.mjs test/daemon.test.mjs test/database.test.mjs test/diagnostics.test.mjs test/kokoro-runtime.test.mjs test/mcp-skills.test.mjs test/memory-center.test.mjs test/model-bootstrap.test.mjs test/orchestration.test.mjs test/providers.test.mjs test/tools.test.mjs test/voice-hud.test.mjs test/wake-fixtures.test.mjs test/whisper-fixture.test.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dotenv": "^17.2.3",
    "electron": "^39.2.1",
    "express": "^5.1.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^0.468.0",
    "npyz": "^0.4.2",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7",
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "nanoid": "^3.3.17",
    "brace-expansion": "^2.0.1",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.5": true,
    "onnxruntime-node@1.27.0": true,
    "sharp@0.34.5": true
  }
}

