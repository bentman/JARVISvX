{
  "name": "jarvisvx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first voice and terminal AI assistant.",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "jarvis": "./bin/jarvis.mjs"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node daemon.mjs",
    "daemon": "node daemon.mjs",
    "desktop": "electron .",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npx wait-on http://127.0.0.1:3210 && electron .\"",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "lint": "tsc --noEmit && eslint ."
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dotenv": "^17.2.3",
    "electron": "^41.10.5",
    "express": "^5.1.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^0.468.0",
    "npyz": "^0.4.2",
    "onnxruntime-node": "^1.22.0",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.2",
    "wait-on": "^9.0.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "nanoid": "^3.3.17",
    "brace-expansion": "^2.0.1",
    "sharp": "^0.35.0",
    "extract-zip": "^2.0.1"
  },
  "allowScripts": {
    "onnxruntime-node": true,
    "protobufjs": true,
    "sharp": true,
    "esbuild": true,
    "electron": true
  }
}
