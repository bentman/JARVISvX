# Local provider defaults
# Data storage root — leave empty to use ./data (project-local default).
# Any valid filesystem path is accepted: absolute, relative, or tilde-prefix.
#   Windows: JARVIS_DATA_DIR=E:\ProgramData\.jarvis\data
#   POSIX:   JARVIS_DATA_DIR=~/.jarvis/data
# Moving an existing data directory is deliberate: the desktop host asks, and
# every other caller needs the authorization below for that one run.
JARVIS_DATA_DIR=

# Authorizes one move of an existing data directory to JARVIS_DATA_DIR. Set it
# for the single run that relocates, then clear it — a start with nothing to
# move never needs it.
JARVIS_DATA_MIGRATE=

# Voice model storage — leave empty to use ./models (project-local default).
JARVIS_MODEL_DIR=

# Download staging — leave empty to use ./cache/temp (project-local default).
JARVIS_TEMP_DIR=

# Encryption salt for stored API keys (AES-256-GCM).
# Set this to any random string to make provider credentials portable across hosts.
# If left empty, a salt file is auto-generated in JARVIS_DATA_DIR and travels with the data.
# WARNING: changing this value will invalidate all stored API keys (re-entry required).
JARVIS_KEY_SALT=

# Application Setup Defaults
JARVIS_PORT=3210
JARVIS_LLAMACPP_URL=http://127.0.0.1:8080/v1
JARVIS_OLLAMA_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible cloud provider. It is used only with explicit request approval.
JARVIS_CLOUD_URL=
JARVIS_CLOUD_MODEL=
JARVIS_CLOUD_API_KEY=

