# Local provider defaults
# Data storage root — leave empty to use ./data (project-local default).
# Any valid filesystem path is accepted: absolute, relative, or tilde-prefix.
#   Windows: JARVIS_DATA_DIR=E:\ProgramData\.jarvis\data
#   POSIX:   JARVIS_DATA_DIR=~/.jarvis/data
# When changed, the app will offer to import existing data or start fresh.
JARVIS_DATA_DIR=
JARVIS_PORT=3210
JARVIS_LLAMACPP_URL=http://127.0.0.1:8080/v1
JARVIS_OLLAMA_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible cloud provider. It is used only with explicit request approval.
JARVIS_CLOUD_URL=
JARVIS_CLOUD_MODEL=
JARVIS_CLOUD_API_KEY=

